  \};\par
\par
  const observer = new IntersectionObserver((entries, obs) =&gt; \{\par
    entries.forEach(entry =&gt; \{\par
      if (entry.isIntersecting) \{\par
        entry.target.classList.add("fade-in-up", "visible");\par
        obs.unobserve(entry.target);\par
